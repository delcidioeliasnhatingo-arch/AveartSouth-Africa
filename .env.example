# FASHN_VTON_URL: Private HTTPS URL for the self-hosted open-source FASHN VTON GPU service.
FASHN_VTON_URL=""

# FASHN_VTON_TOKEN: Shared secret used by the Vercel proxy and private inference service.
FASHN_VTON_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
