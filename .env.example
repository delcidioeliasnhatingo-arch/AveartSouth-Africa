# GEMINI_API_KEY: Required by the AVEART AI Photo Try-On endpoint.
# Add this as a server-side environment variable in Vercel. Never expose it as VITE_GEMINI_API_KEY.
# AI Studio deployments may inject this from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
